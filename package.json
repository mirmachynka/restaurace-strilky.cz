{
  "author": "Miroslav Machynka (Trebired)",
  "config": {
    "organization": {
      "displayName": "Trebired",
      "name": "trebired",
      "website": "https://trebired.com"
    },
    "product": {
      "displayName": "Restaurace Střílky",
      "name": "restaurace-strilky-cz",
      "website": "https://restaurace-strilky.cz"
    }
  },
  "name": "restaurace-strilky-cz",
  "version": "1.0.3",
  "description": "Marketing site for Restaurace Střílky: restaurant, pub and accommodation. React frontend, static build, no backend.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.0.0"
  },
  "scripts": {
    "dev": "code-discipline gate -- bun --hot src/bin/dev.ts",
    "build": "bun src/bin/frontend/build.ts client",
    "discipline:check": "code-discipline check",
    "typecheck": "tsc --noEmit",
    "verify": "bun run discipline:check && bun run typecheck && bun run build"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/playfair-display": "^5.3.0",
    "@trebired/bundler": "^5.13.1",
    "@trebired/frontend": "13.1.2",
    "@trebired/i18n": "^0.6.1",
    "@trebired/logger": "^2.7.1",
    "@trebired/seo": "^0.4.0",
    "@trebired/startup": "^0.7.1",
    "@trebired/utils": "^0.9.4",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@trebired/code-discipline": "^7.2.1",
    "@trebired/configs": "^0.4.0",
    "@types/bun": "^1.4.0",
    "@types/node": "^22.20.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "sass": "^1.103.1",
    "sharp": "^0.34.5",
    "typescript": "5.7.3"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/mirmachynka/restaurace-strilky.cz.git"
  },
  "homepage": "https://restaurace-strilky.cz",
  "bugs": {
    "url": "https://github.com/mirmachynka/restaurace-strilky.cz/issues"
  }
}
